{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/node-link/v1/command.schema.json",
  "title": "ACP Remote Node Link v1 Command Messages",
  "oneOf": [
    {
      "$ref": "#/$defs/commandSubmit"
    },
    {
      "$ref": "#/$defs/commandAccepted"
    },
    {
      "$ref": "#/$defs/commandRejected"
    },
    {
      "$ref": "#/$defs/commandTerminal"
    },
    {
      "$ref": "#/$defs/commandStatus"
    }
  ],
  "$defs": {
    "postAuthBase": {
      "type": "object",
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "connectionId",
        "connectionSequence",
        "body"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "connectionId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "connectionSequence": {
          "$ref": "common.schema.json#/$defs/decimalString"
        }
      }
    },
    "commandName": {
      "enum": [
        "session.list",
        "session.read",
        "command.status",
        "session.mode.list",
        "session.config.list",
        "session.prompt",
        "session.cancel",
        "elicitation.respond",
        "session.mode.set",
        "session.config.set",
        "permission.resolve",
        "session.create",
        "session.resume"
      ],
      "description": "唯一来源是 compatibility/commands/v1/commands.json；顺序与 transport 含 node_link 的命令集合一致。"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "promptContentBlock": {
      "description": "用户输入的内容块，字段与 Sync 面 `common.schema.json#/$defs/promptContentBlock` 同名同义（docs/NODE_LINK_PROTOCOL.md §12.7）。text 始终可用；attachment_ref 只在协商 `node-link.attachment-transfer.v1` 且附件已封存、已绑定同一会话/主体时接受；workspace_path_ref 只表示当前会话工作目录内的相对路径，不固定版本、不追踪内容变化。未协商时新分支必须缺席，不得把附件伪装成文本。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1, "maxLength": 262144 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "attachmentId", "mediaType", "byteLength", "sha256"],
          "properties": {
            "type": { "const": "attachment_ref" },
            "attachmentId": { "$ref": "common.schema.json#/$defs/uuid" },
            "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
            "byteLength": { "$ref": "common.schema.json#/$defs/decimalString" },
            "sha256": { "$ref": "common.schema.json#/$defs/base64url32" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "workspace_path_ref" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*:)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000-\\u001f]+$",
              "description": "会话工作目录内的相对路径；拒绝绝对路径、盘符/ADS 的冒号、. 与 .. 分量以及控制字符。"
            }
          }
        }
      ]
    },
    "configValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "boolean"
        }
      ]
    },
    "submitBase": {
      "type": "object",
      "required": [
        "requestId",
        "command",
        "sessionRef",
        "attachmentId",
        "attachmentGeneration",
        "expectedVersion",
        "payload"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "command": {
          "$ref": "#/$defs/commandName"
        },
        "sessionRef": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachmentId": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachmentGeneration": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedVersion": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sessionCreatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "directoryId"
      ],
      "description": "session.create 只允许这两个键。出现 cwd、mcpServers、任何绝对路径或凭据字段时必须返回 command.rejected + nodelink.command.unsupported_field，且不得创建会话或部分应用参数。",
      "properties": {
        "agentId": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "directoryId": {
          "$ref": "common.schema.json#/$defs/directoryId"
        }
      }
    },
    "commandSubmit": {
      "allOf": [
        {
          "$ref": "#/$defs/postAuthBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "command.submit"
            },
            "body": {
              "oneOf": [
                {
                  "$ref": "#/$defs/submitSessionList"
                },
                {
                  "$ref": "#/$defs/submitSessionRead"
                },
                {
                  "$ref": "#/$defs/submitCommandStatus"
                },
                {
                  "$ref": "#/$defs/submitSessionModeList"
                },
                {
                  "$ref": "#/$defs/submitSessionConfigList"
                },
                {
                  "$ref": "#/$defs/submitSessionPrompt"
                },
                {
                  "$ref": "#/$defs/submitSessionCancel"
                },
                {
                  "$ref": "#/$defs/submitElicitationRespond"
                },
                {
                  "$ref": "#/$defs/submitSessionModeSet"
                },
                {
                  "$ref": "#/$defs/submitSessionConfigSet"
                },
                {
                  "$ref": "#/$defs/submitPermissionResolve"
                },
                {
                  "$ref": "#/$defs/submitSessionCreate"
                },
                {
                  "$ref": "#/$defs/submitSessionResume"
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionList": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.list"
            },
            "sessionRef": {
              "type": "null"
            },
            "attachmentId": {
              "type": "null"
            },
            "attachmentGeneration": {
              "type": "null"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sessionReadBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "messageId"
      ],
      "properties": {
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      },
      "description": "session.read 消息页的复合游标（docs/NODE_LINK_PROTOCOL.md §12.7），与 Sync 面 §11.5 的 before 同义：两个键必须同时出现，单字段游标被拒绝。"
    },
    "submitSessionRead": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.read"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "include"
              ],
              "properties": {
                "include": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "messages",
                      "turns",
                      "pending_interactions",
                      "config_options",
                      "capabilities",
                      "history"
                    ]
                  }
                },
                "beforeHistory": {
                  "$ref": "common.schema.json#/$defs/decimalString",
                  "description": "历史条目游标：origin 会话内事件序号（docs/NODE_LINK_PROTOCOL.md §12.7/§12.10），与 Sync 面同义。`history` 与 `beforeHistory` 只在协商 `node-link.remote-history.v1` 后接受；未协商的旧 peer 省略这两个键，请求行为与本变更前一致。"
                },
                "before": {
                  "$ref": "#/$defs/sessionReadBefore",
                  "description": "消息页游标（`core` 的 `(createdAt, messageId)` 复合游标），与 Sync 面 §11.5 的 `before` 同义。只在协商 `node-link.remote-history.v1` 后接受；未协商的连接发送它按 `nodelink.command.unsupported_field` 拒绝。"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "本页消息条数上限（结构常量，不是十进制字符串）。省略时使用服务端默认页；超过服务端上限时收敛到上限并照常返回。只在协商 `node-link.remote-history.v1` 后接受。"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitCommandStatus": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "command.status"
            },
            "sessionRef": {
              "type": "null"
            },
            "attachmentId": {
              "type": "null"
            },
            "attachmentGeneration": {
              "type": "null"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "targetRequestId"
              ],
              "properties": {
                "targetRequestId": {
                  "$ref": "#/$defs/requestId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionModeList": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.mode.list"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionConfigList": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.config.list"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionPrompt": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.prompt"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content"
              ],
              "properties": {
                "content": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/promptContentBlock"
                  }
                },
                "submissionId": {
                  "$ref": "common.schema.json#/$defs/uuid",
                  "description": "本节点连接上已 `manifest_sealed` 的附件清单标识（docs/NODE_LINK_PROTOCOL.md §12.7）。只在协商 `node-link.attachment-transfer.v1` 后被接受；未协商的旧 peer 省略该键，服务端不得因它缺席而丢弃附件引用，也不得为缺席的清单补造绑定。"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionCancel": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.cancel"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turnId"
              ],
              "properties": {
                "turnId": {
                  "$ref": "common.schema.json#/$defs/uuid"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitElicitationRespond": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "elicitation.respond"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "interactionId",
                    "action",
                    "values"
                  ],
                  "properties": {
                    "interactionId": {
                      "$ref": "common.schema.json#/$defs/uuid"
                    },
                    "requestVersion": {
                      "$ref": "common.schema.json#/$defs/decimalString",
                      "description": "当前有效请求的版本（docs/NODE_LINK_PROTOCOL.md §12.10）；协商 `node-link.pending-interactions.v1` 后必须携带，未协商的旧 peer 可省略，服务端不得据缺省值猜测版本。"
                    },
                    "action": {
                      "const": "submit"
                    },
                    "values": {
                      "type": ["object", "null"],
                      "additionalProperties": true,
                      "description": "开放扩展点：elicit 表单提交值，形状由该次 elicitation 的 schema 决定；`null` 对应 ACP `accept` 的 `content: null`。"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "interactionId",
                    "action",
                    "values"
                  ],
                  "properties": {
                    "interactionId": {
                      "$ref": "common.schema.json#/$defs/uuid"
                    },
                    "requestVersion": {
                      "$ref": "common.schema.json#/$defs/decimalString",
                      "description": "当前有效请求的版本（docs/NODE_LINK_PROTOCOL.md §12.10）；协商 `node-link.pending-interactions.v1` 后必须携带，未协商的旧 peer 可省略，服务端不得据缺省值猜测版本。"
                    },
                    "action": {
                      "const": "decline"
                    },
                    "values": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "interactionId",
                    "action",
                    "values"
                  ],
                  "properties": {
                    "interactionId": {
                      "$ref": "common.schema.json#/$defs/uuid"
                    },
                    "requestVersion": {
                      "$ref": "common.schema.json#/$defs/decimalString",
                      "description": "当前有效请求的版本（docs/NODE_LINK_PROTOCOL.md §12.10）；协商 `node-link.pending-interactions.v1` 后必须携带，未协商的旧 peer 可省略，服务端不得据缺省值猜测版本。"
                    },
                    "action": {
                      "const": "cancel"
                    },
                    "values": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionModeSet": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.mode.set"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "modeId"
              ],
              "properties": {
                "modeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionConfigSet": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.config.set"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configId",
                "value"
              ],
              "properties": {
                "configId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "value": {
                  "$ref": "#/$defs/configValue"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitPermissionResolve": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "permission.resolve"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "attachmentGeneration": {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interactionId",
                "optionId"
              ],
              "properties": {
                "interactionId": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "requestVersion": {
                  "$ref": "common.schema.json#/$defs/decimalString",
                  "description": "当前有效请求的版本（docs/NODE_LINK_PROTOCOL.md §12.10）；协商 `node-link.pending-interactions.v1` 后必须携带，未协商的旧 peer 可省略，服务端不得据缺省值猜测版本。"
                },
                "optionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionCreate": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.create"
            },
            "sessionRef": {
              "type": "null"
            },
            "attachmentId": {
              "type": "null"
            },
            "attachmentGeneration": {
              "type": "null"
            },
            "expectedVersion": {
              "type": "null"
            },
            "payload": {
              "$ref": "#/$defs/sessionCreatePayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submitSessionResume": {
      "allOf": [
        {
          "$ref": "#/$defs/submitBase"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "const": "session.resume"
            },
            "sessionRef": {
              "$ref": "common.schema.json#/$defs/remoteSessionRef"
            },
            "attachmentId": {
