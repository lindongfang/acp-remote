{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.local/schemas/acp/compatibility-matrix.schema.json",
  "title": "ACP Remote compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "protocol", "testFamilies", "methods", "sessionUpdates", "contentBlocks", "toolCallContents", "capabilities", "invariants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "wireVersion", "sourceCommit", "schemaUrl", "schemaSha256", "checkedAt"],
      "properties": {
        "name": { "const": "ACP" },
        "wireVersion": { "const": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "schemaUrl": { "type": "string", "format": "uri" },
        "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "checkedAt": { "type": "string", "format": "date" }
      }
    },
    "testFamilies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/testFamily" } },
    "methods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/method" } },
    "sessionUpdates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } },
    "contentBlocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } },
    "toolCallContents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
    "invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/invariant" } }
  },
  "$defs": {
    "delivery": { "enum": ["mvp", "conditional_mvp", "post_mvp", "always"] },
    "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acp", "broker", "sync", "pwa", "facade"],
      "properties": {
        "acp": { "enum": ["native", "raw_preserve", "transport_control"] },
        "broker": { "enum": ["project_and_preserve", "local_service", "pass_through", "explicit_unsupported", "not_applicable"] },
        "sync": { "enum": ["command", "event", "snapshot", "raw_fallback", "explicit_unsupported", "not_exposed"] },
        "pwa": { "enum": ["full", "view_only", "explicit_unsupported", "not_applicable"] },
        "facade": { "enum": ["baseline", "advertise_if_end_to_end", "not_advertised", "not_applicable"] }
      }
    },
    "testFamily": {
      "type": "object", "additionalProperties": false, "required": ["id", "owner"],
      "properties": { "id": { "type": "string" }, "owner": { "type": "string" } }
    },
    "base": {
      "type": "object",
      "required": ["id", "delivery", "layers", "tests"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "delivery": { "$ref": "#/$defs/delivery" },
        "layers": { "$ref": "#/$defs/layers" },
        "tests": { "$ref": "#/$defs/tests" }
      }
    },
    "method": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "wireName", "direction", "kind", "requirement", "capability", "delivery", "layers", "tests"],
          "properties": {
            "id": { "type": "string" }, "wireName": { "type": "string" },
            "direction": { "enum": ["client_to_agent", "agent_to_client", "bidirectional"] },
            "kind": { "enum": ["request", "notification"] },
            "requirement": { "enum": ["baseline", "optional", "conditional"] },
            "capability": { "type": ["string", "null"] },
            "delivery": { "$ref": "#/$defs/delivery" }, "layers": { "$ref": "#/$defs/layers" }, "tests": { "$ref": "#/$defs/tests" }
          }
        }
      ]
    },
    "feature": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "wireValue", "delivery", "layers", "tests"],
          "properties": {
            "id": { "type": "string" }, "wireValue": { "type": "string" },
            "capability": { "type": ["string", "null"] },
            "delivery": { "$ref": "#/$defs/delivery" }, "layers": { "$ref": "#/$defs/layers" }, "tests": { "$ref": "#/$defs/tests" }
          }
        }
      ]
    },
    "capability": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "path", "advertisedBy", "delivery", "layers", "tests"],
          "properties": {
            "id": { "type": "string" }, "path": { "type": "string" },
            "advertisedBy": { "enum": ["client", "agent"] },
            "delivery": { "$ref": "#/$defs/delivery" }, "layers": { "$ref": "#/$defs/layers" }, "tests": { "$ref": "#/$defs/tests" }
          }
        }
      ]
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fixture", "expectation", "tests"],
      "properties": {
        "id": { "type": "string" }, "fixture": { "type": "string" },
        "expectation": { "enum": ["byte_exact", "structured_not_text", "explicit_unsupported", "truthful_negotiation"] },
        "tests": { "$ref": "#/$defs/tests" }
      }
    }
  }
}
