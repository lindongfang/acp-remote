{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/attachment.schema.json",
  "title": "ACP Remote Sync v1 Attachment Transfer Connection",
  "description": "独立已认证附件 WSS 连接（docs/SYNC_PROTOCOL.md §3.4）的帧联合入口。它**不是** message.schema.json 的一部分：只有在双方协商 core.attachment-transfer.v1 后，连接才在完成与业务连接相同的 challenge-response 后进入本帧族；未协商的连接收到任何 attachment.* 帧都按协议错误关闭。偏移、长度一律是无前导零十进制字符串；transferId 与会话/主体绑定在每一帧重复，不因连接复用而省略。",
  "oneOf": [
    { "$ref": "#/$defs/begin" },
    { "$ref": "#/$defs/chunk" },
    { "$ref": "#/$defs/chunkAck" },
    { "$ref": "#/$defs/seal" },
    { "$ref": "#/$defs/sealed" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/abort" },
    { "$ref": "#/$defs/read" },
    { "$ref": "#/$defs/readChunk" },
    { "$ref": "#/$defs/manifestBegin" },
    { "$ref": "#/$defs/manifestPage" },
    { "$ref": "#/$defs/manifestSealed" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "frameType": {
      "type": "string",
      "description": "唯一机器定义：compatibility/commands/v1/commands.json 的 transportFrames 与 docs/SYNC_PROTOCOL.md §3.4 的帧表都断言与它相等。",
      "enum": [
        "attachment.begin",
        "attachment.chunk",
        "attachment.chunk_ack",
        "attachment.seal",
        "attachment.sealed",
        "attachment.status",
        "attachment.abort",
        "attachment.read",
        "attachment.read_chunk",
        "attachment.manifest_begin",
        "attachment.manifest_page",
        "attachment.manifest_sealed",
        "attachment.error"
      ]
    },
    "transferBudget": {
      "type": "object",
      "description": "运行保护（不是附件数量/大小产品额度）。单块原始数据 32 KiB；每传输最多一块未确认；单设备 2 个、单节点 8 个活动传输；单连接发送预算与速率按传输族独立计数。取值是固定 v1 常量，不得通过 limits 下调或覆盖。",
      "additionalProperties": false,
      "required": ["chunkSize", "maxUnacknowledgedChunks", "maxActiveTransfersPerDevice", "maxActiveTransfersPerNode"],
      "properties": {
        "chunkSize": { "const": 32768 },
        "maxUnacknowledgedChunks": { "const": 1 },
        "maxActiveTransfersPerDevice": { "const": 2 },
        "maxActiveTransfersPerNode": { "const": 8 }
      }
    },
    "subject": {
      "type": "object",
      "description": "传输主体绑定。Sync 面只接受设备；kind 是封闭取值，收到 node 属于跨主体冒用。",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "device" },
        "id": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "base": {
      "type": "object",
      "required": ["protocolVersion", "type", "messageId", "connectionId", "connectionSequence", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionSequence": { "$ref": "common.schema.json#/$defs/decimalString" },
        "body": { "type": "object" }
      }
    },
    "beginBody": {
      "description": "`attachment.begin` 的 body：上传只绑定**已存在的正式会话**（顶层 `sessionId`），形状闭合（`additionalProperties: false` 与 `required` 同时生效）。准备附件目标已被整体移除（`docs/SYNC_PROTOCOL.md` §3.4）：出现 `target`、`receipt`、`runtimeEpoch` 或 `generation` 等字段按 `protocol.schema_invalid` 拒绝，不触碰存储。",
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "sessionId", "subject", "totalLength", "chunkSize", "mediaType", "fileName"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "subject": { "$ref": "#/$defs/subject" },
        "totalLength": { "$ref": "common.schema.json#/$defs/decimalString" },
        "chunkSize": { "const": 32768 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "chunkBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "offset", "data"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "offset": { "$ref": "common.schema.json#/$defs/decimalString" },
        "data": {
          "description": "单块原始数据 ≤ 32768 字节，非填充 base64url；43691 = ceil(32768 * 4 / 3)。",
          "allOf": [
            { "$ref": "common.schema.json#/$defs/base64url" },
            { "minLength": 1, "maxLength": 43691 }
          ]
        }
      }
    },
    "chunkAckBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "offset", "length", "duplicate", "nextOffset"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "offset": { "$ref": "common.schema.json#/$defs/decimalString" },
        "length": { "$ref": "common.schema.json#/$defs/decimalString" },
        "duplicate": {
          "type": "boolean",
          "description": "true 表示该偏移的块已接受过且内容相同，本次返回原确认；内容不同则整个请求以 attachment.chunk_conflict 拒绝。"
        },
        "nextOffset": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "sealBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "length", "sha256"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "length": { "$ref": "common.schema.json#/$defs/decimalString" },
        "sha256": { "$ref": "common.schema.json#/$defs/base64url32" }
      }
    },
    "sealedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "attachmentId", "length", "sha256", "sealedAt"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "attachmentId": { "$ref": "common.schema.json#/$defs/uuid" },
        "length": { "$ref": "common.schema.json#/$defs/decimalString" },
        "sha256": { "$ref": "common.schema.json#/$defs/base64url32" },
        "sealedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "statusBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "state", "receivedLength", "nextOffset", "sealedSha256"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "enum": ["receiving", "sealed", "aborted", "expired"] },
        "receivedLength": { "$ref": "common.schema.json#/$defs/decimalString" },
        "nextOffset": { "$ref": "common.schema.json#/$defs/decimalString" },
        "sealedSha256": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/base64url32" }, { "type": "null" }]
        }
      }
    },
    "abortBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transferId", "reason"],
      "properties": {
        "transferId": { "$ref": "common.schema.json#/$defs/uuid" },
        "reason": { "enum": ["client_cancelled", "budget_exceeded", "revoked", "digest_mismatch"] }
      }
    },
    "readBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId", "sessionId", "offset", "maxLength"],
      "properties": {
        "attachmentId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "offset": { "$ref": "common.schema.json#/$defs/decimalString" },
        "maxLength": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "readChunkBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId", "sessionId", "offset", "length", "totalLength", "data", "eof"],
      "properties": {
        "attachmentId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "offset": { "$ref": "common.schema.json#/$defs/decimalString" },
        "length": { "$ref": "common.schema.json#/$defs/decimalString" },
        "totalLength": { "$ref": "common.schema.json#/$defs/decimalString" },
        "data": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/base64url" },
            { "minLength": 1, "maxLength": 43691 }
          ]
        },
        "eof": { "type": "boolean" }
      }
    },
    "manifestBeginBody": {
      "description": "`attachment.manifest_begin` 的 body：清单只绑定**已存在的正式会话**（顶层 `sessionId`），形状闭合。`submissionId` 是**附件清单**标识，`session.prompt` 用它引用已封存的清单；准备清单已被整体移除（`docs/SYNC_PROTOCOL.md` §3.4），出现 `target` 及其运行期字段按 `protocol.schema_invalid` 拒绝。清单里的每个 `transferId` 必须已封存在同设备/同 sessionId 下。",
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionId", "sessionId", "subject", "attachmentCount"],
      "properties": {
        "submissionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "subject": { "$ref": "#/$defs/subject" },
        "attachmentCount": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "manifestPageBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionId", "transferIds", "final"],
      "properties": {
        "submissionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "transferIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/uuid" }
        },
        "final": { "type": "boolean" }
      }
    },
    "manifestSealedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionId", "attachmentCount", "manifestDigest", "sealedAt"],
      "properties": {
        "submissionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "attachmentCount": { "$ref": "common.schema.json#/$defs/decimalString" },
        "manifestDigest": { "$ref": "common.schema.json#/$defs/base64url32" },
        "sealedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "transferId", "details"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/errorCode" },
        "message": { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" },
        "transferId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "details": { "type": "object" }
      }
    },
    "begin": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.begin" },
            "body": { "$ref": "#/$defs/beginBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chunk": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.chunk" },
            "body": { "$ref": "#/$defs/chunkBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chunkAck": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.chunk_ack" },
            "body": { "$ref": "#/$defs/chunkAckBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "seal": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.seal" },
            "body": { "$ref": "#/$defs/sealBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sealed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.sealed" },
            "body": { "$ref": "#/$defs/sealedBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "status": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.status" },
            "body": { "$ref": "#/$defs/statusBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "abort": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.abort" },
            "body": { "$ref": "#/$defs/abortBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "read": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.read" },
            "body": { "$ref": "#/$defs/readBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "readChunk": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.read_chunk" },
            "body": { "$ref": "#/$defs/readChunkBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "manifestBegin": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.manifest_begin" },
            "body": { "$ref": "#/$defs/manifestBeginBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "manifestPage": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.manifest_page" },
            "body": { "$ref": "#/$defs/manifestPageBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "manifestSealed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.manifest_sealed" },
            "body": { "$ref": "#/$defs/manifestSealedBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "attachment.error" },
            "body": { "$ref": "#/$defs/errorBody" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
