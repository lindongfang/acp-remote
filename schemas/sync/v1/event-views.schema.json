{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/event-views.schema.json",
  "title": "ACP Remote Sync v1 Event View Definitions",
  "description": "Minimum required fields for event.payload.view, one $defs entry per event type registered in docs/SYNC_PROTOCOL.md section 10.2. Every view is an open object: additionalProperties is true, and adding fields requires a negotiated feature. Backward-compatible optional fields (such as toolDetail) do not require feature negotiation.",
  "$defs": {
    "session.created": {
      "type": "object",
      "required": ["session"],
      "properties": {
        "session": { "$ref": "common.schema.json#/$defs/sessionSummary" }
      },
      "additionalProperties": true
    },
    "session.updated": {
      "type": "object",
      "required": ["session"],
      "properties": {
        "session": { "$ref": "common.schema.json#/$defs/sessionSummary" }
      },
      "additionalProperties": true
    },
    "session.activity.changed": {
      "type": "object",
      "description": "`core.local-session-lifecycle.v1` 的本机生命周期变化视图：携带**事件发生当时**的完整 owned 会话摘要（含可选的 `localActivity`）。只在 `localActivity` 的取值**实际变化**时写出：`session.resume` 命中 ready 复用且归约仍是 `active` 时**不写**，`idle` → `active`（重新恢复成功、资源代就绪）**必写**，`active` → `idle`（确认释放且无任务/交互）同样必写；查看声明、离页与租约到期都不改变归约结果，因此 MUST NOT 触发本事件（docs/SYNC_PROTOCOL.md §9.8）。它只在本机 owned 路径交付，Node Link 不转发；事件保存的是当时的事实，不得据此推断重启后资源仍然存活——重启后由当前生命周期查询收敛。",
      "required": ["session"],
      "properties": {
        "session": { "$ref": "common.schema.json#/$defs/sessionSummary" }
      },
      "additionalProperties": true
    },
    "session.info.changed": {
      "type": "object",
      "required": ["title", "updatedAt"],
      "properties": {
        "title": { "type": ["string", "null"], "maxLength": 512 },
        "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": true
    },
    "session.config.changed": {
      "type": "object",
      "required": ["configOptions", "version"],
      "properties": {
        "configOptions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/configOptionView" }
        },
        "version": { "$ref": "common.schema.json#/$defs/decimalString" }
      },
      "additionalProperties": true
    },
    "session.mode.changed": {
      "type": "object",
      "required": ["currentModeId", "version"],
      "properties": {
        "currentModeId": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "version": { "$ref": "common.schema.json#/$defs/decimalString" }
      },
      "additionalProperties": true
    },
    "session.plan.changed": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["content", "priority", "status"],
            "properties": {
              "content": { "type": "string", "maxLength": 4096 },
              "priority": { "enum": ["high", "medium", "low"] },
              "status": { "enum": ["pending", "in_progress", "completed"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "session.commands.changed": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "description": { "type": "string", "maxLength": 1024 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "session.usage.changed": {
      "type": "object",
      "required": ["used", "size"],
      "properties": {
        "used": { "$ref": "common.schema.json#/$defs/decimalString" },
        "size": { "$ref": "common.schema.json#/$defs/decimalString" }
      },
      "additionalProperties": true
    },
    "session.origin.online_changed": {
      "type": "object",
      "required": ["ownerNodeId", "originEpoch", "online"],
      "properties": {
        "ownerNodeId": { "$ref": "common.schema.json#/$defs/uuid" },
        "originEpoch": { "$ref": "common.schema.json#/$defs/uuid" },
        "online": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "turn.queued": {
      "type": "object",
      "required": ["turnId", "state"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": true
    },
    "turn.started": {
      "type": "object",
      "required": ["turnId", "state"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": true
    },
    "turn.completed": {
      "type": "object",
      "required": ["turnId", "state"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": true
    },
    "turn.cancelled": {
      "type": "object",
      "required": ["turnId", "state"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": true
    },
    "turn.failed": {
      "type": "object",
      "required": ["turnId", "state", "error"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "const": "failed" },
        "error": { "$ref": "common.schema.json#/$defs/publicError" }
      },
      "additionalProperties": true
    },
    "turn.delta_compacted": {
      "type": "object",
      "required": ["turnId", "deltaCount"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deltaCount": { "$ref": "common.schema.json#/$defs/decimalString" }
      },
      "additionalProperties": true
    },
    "user.message.delta": {
      "type": "object",
      "required": ["messageId", "turnId", "deltaIndex", "text"],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deltaIndex": { "$ref": "common.schema.json#/$defs/decimalString" },
        "text": { "type": "string", "maxLength": 262144 }
      },
      "additionalProperties": true
    },
    "agent.message.delta": {
      "type": "object",
      "required": ["messageId", "turnId", "deltaIndex", "text"],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deltaIndex": { "$ref": "common.schema.json#/$defs/decimalString" },
        "text": { "type": "string", "maxLength": 262144 },
        "block": { "$ref": "common.schema.json#/$defs/agentContentBlock" }
      },
      "additionalProperties": true
    },
    "agent.thought.delta": {
      "type": "object",
      "required": ["messageId", "turnId", "deltaIndex", "text"],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deltaIndex": { "$ref": "common.schema.json#/$defs/decimalString" },
        "text": { "type": "string", "maxLength": 262144 }
      },
      "additionalProperties": true
    },
    "agent.message.completed": {
      "type": "object",
      "required": ["messageId", "turnId", "content"],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "content": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/agentContentBlock" }
        },
        "channel": { "$ref": "media.schema.json#/$defs/messageChannel" },
        "partial": { "$ref": "media.schema.json#/$defs/partialResult" }
      },
      "additionalProperties": true
    },
    "tool.call.started": {
      "type": "object",
      "required": ["toolCallId", "turnId", "title", "state"],
      "properties": {
        "toolCallId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1024 },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "toolDetail": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "input": { "not": { "type": "null" } },
            "output": { "not": { "type": "null" } },
            "text": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "truncatedParts": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["input", "output", "text"] },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tool.call.updated": {
      "type": "object",
      "required": ["toolCallId", "turnId", "title", "state"],
      "properties": {
        "toolCallId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1024 },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "toolDetail": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "input": { "not": { "type": "null" } },
            "output": { "not": { "type": "null" } },
            "text": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "truncatedParts": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["input", "output", "text"] },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tool.call.completed": {
      "type": "object",
      "required": ["toolCallId", "turnId", "title", "state"],
      "properties": {
        "toolCallId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1024 },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "toolDetail": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "input": { "not": { "type": "null" } },
            "output": { "not": { "type": "null" } },
            "text": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "truncatedParts": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["input", "output", "text"] },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "permission.requested": {
      "type": "object",
      "required": ["interactionId", "turnId", "title", "description", "options"],
      "properties": {
        "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1024 },
        "description": { "type": ["string", "null"], "maxLength": 4096 },
        "toolCallId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "toolKind": { "type": "string", "minLength": 1, "maxLength": 256 },
        "toolDetail": { "$ref": "#/$defs/tool.call.started/properties/toolDetail" },
        "options": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/interactionOption" }
        }
      },
      "additionalProperties": true
    },
    "permission.resolved": {
      "type": "object",
      "required": ["interactionId", "resolution", "resolvedByDeviceId"],
      "properties": {
        "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "resolution": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resolvedByDeviceId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "elicitation.requested": {
      "type": "object",
      "required": ["interactionId", "turnId", "title", "schema", "initialValues"],
      "properties": {
        "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1024 },
        "schema": { "type": "object" },
        "initialValues": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "elicitation.resolved": {
      "type": "object",
      "required": ["interactionId", "action", "resolvedByDeviceId"],
      "properties": {
        "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "action": { "enum": ["submit", "decline", "cancel"] },
        "resolvedByDeviceId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "terminal.output": {
      "type": "object",
      "required": ["terminalId", "chunkIndex", "stream", "text", "truncated"],
      "properties": {
        "terminalId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "chunkIndex": { "$ref": "common.schema.json#/$defs/decimalString" },
        "stream": { "enum": ["stdout", "stderr"] },
        "text": { "type": "string", "maxLength": 1048576 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "file.changed": {
      "type": "object",
      "required": ["changeId", "kind", "displayPath", "summary"],
      "not": { "required": ["diffLines", "diffUnavailable"] },
      "properties": {
        "changeId": { "$ref": "common.schema.json#/$defs/uuid" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "displayPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "summary": { "type": "string", "maxLength": 2048 },
        "addedLines": { "$ref": "common.schema.json#/$defs/decimalString" },
        "deletedLines": { "$ref": "common.schema.json#/$defs/decimalString" },
        "outsideWorkspace": { "type": "boolean" },
        "diffLines": {
          "description": "结构化差异行（feature `core.file-diff.v1` 门控）：每行逐条标明新增、删除或上下文，客户端据此渲染而不必解析任何原文。未协商该 feature 时该键 MUST **缺席**（不是空数组，也不是占位行）；差异行因超出单条上限而未随事件下发时同样缺席，改由 `diffUnavailable` 说明原因。键在场即至少一行，因此 `minItems` 是 1。",
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "properties": {
              "kind": { "enum": ["added", "deleted", "context"] },
              "text": { "type": "string", "maxLength": 4096 }
            },
            "additionalProperties": true
          }
        },
        "diffUnavailable": {
          "description": "差异行未随本事件下发时的显式标记（feature `core.file-diff.v1` 门控），与 `diffLines` 互斥：`reason` 只取已登记的取值，客户端据此呈现明确说明而不是空白的差异区。",
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": { "enum": ["size_limit"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "agent.connected": {
      "type": "object",
      "required": ["agentId", "state"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["connected"] }
      },
      "additionalProperties": true
    },
    "agent.disconnected": {
      "type": "object",
      "required": ["agentId", "state"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["disconnected"] },
        "error": { "$ref": "common.schema.json#/$defs/publicError" }
      },
      "additionalProperties": true
    },
    "command.completed": {
      "type": "object",
      "required": ["requestId", "result"],
      "properties": {
        "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "result": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "command.failed": {
      "type": "object",
      "required": ["requestId", "error"],
      "properties": {
        "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "error": { "$ref": "common.schema.json#/$defs/publicError" }
      },
      "additionalProperties": true
    },
    "command.uncertain": {
      "type": "object",
      "required": ["requestId", "reason", "mayHaveReachedAgent"],
      "properties": {
        "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
        "mayHaveReachedAgent": { "const": true }
      },
      "additionalProperties": true
    },
    "device.revoked": {
      "type": "object",
      "required": ["deviceId", "revokedAt"],
      "properties": {
        "deviceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "revokedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": true
    }
  }
}
