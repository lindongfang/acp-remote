{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/error.schema.json",
  "title": "ACP Remote Sync v1 Error and Control Messages",
  "oneOf": [
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "postAuthBase": {
      "type": "object",
      "required": ["protocolVersion", "type", "messageId", "connectionId", "connectionSequence", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionSequence": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "preAuthBase": {
      "type": "object",
      "required": ["protocolVersion", "type", "messageId", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" }
      },
      "description": "认证完成前的信封：省略 connectionId 与 connectionSequence（SYNC_PROTOCOL.md §4.1）。"
    },
    "errorBody": {
      "type": "object",
      "required": ["type", "body"],
      "properties": {
        "type": { "const": "error" },
        "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "retryable", "correlationId", "details"],
              "properties": {
                "code": { "$ref": "common.schema.json#/$defs/errorCode" },
                "message": { "type": "string", "maxLength": 1024 },
                "retryable": { "type": "boolean" },
                "correlationId": {
                  "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
                },
                "details": { "type": "object" }
              }
            }
          }
        },
    "error": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "#/$defs/preAuthBase" }, { "$ref": "#/$defs/errorBody" }],
          "unevaluatedProperties": false
        },
        {
          "allOf": [{ "$ref": "#/$defs/postAuthBase" }, { "$ref": "#/$defs/errorBody" }],
          "unevaluatedProperties": false
        }
      ]
    },
    "ping": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "control.ping" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nonce"],
              "properties": { "nonce": { "$ref": "common.schema.json#/$defs/base64url16" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pong": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "control.pong" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nonce"],
              "properties": { "nonce": { "$ref": "common.schema.json#/$defs/base64url16" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
