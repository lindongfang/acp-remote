{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/command.schema.json",
  "title": "ACP Remote Sync v1 Commands",
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/commandResult" }
  ],
  "$defs": {
    "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
    "commandName": {
      "description": "唯一来源是 compatibility/commands/v1/commands.json；本枚举只含 transport 含 sync 的命令。session.resume 只经 Node Link 接受，不在本枚举里。",
      "enum": [
        "session.list",
        "session.read",
        "command.status",
        "session.mode.list",
        "session.config.list",
        "session.prompt",
        "session.cancel",
        "elicitation.respond",
        "session.mode.set",
        "session.config.set",
        "permission.resolve",
        "session.create"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "connectionId", "connectionSequence", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "command" },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionSequence": { "$ref": "common.schema.json#/$defs/decimalString" },
        "body": {
          "oneOf": [
            { "$ref": "#/$defs/sessionList" },
            { "$ref": "#/$defs/sessionCreate" },
            { "$ref": "#/$defs/sessionRead" },
            { "$ref": "#/$defs/sessionPrompt" },
            { "$ref": "#/$defs/sessionCancel" },
            { "$ref": "#/$defs/configList" },
            { "$ref": "#/$defs/configSet" },
            { "$ref": "#/$defs/modeList" },
            { "$ref": "#/$defs/modeSet" },
            { "$ref": "#/$defs/permissionResolve" },
            { "$ref": "#/$defs/elicitationRespond" },
            { "$ref": "#/$defs/commandStatus" }
          ]
        }
      }
    },
    "sessionList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.list" },
        "payload": { "type": "object", "additionalProperties": false }
      }
    },
    "sessionCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "payload"],
      "description": "Sync 面的 session.create：body 顶层不得携带 sessionId（会话尚不存在）。payload 只允许 workspaceAlias 与 agentId 两个键——出现 cwd、exportId、templateParams、任何绝对路径、MCP 配置或凭据字段时按 protocol.schema_invalid 拒绝，不得创建会话或部分应用参数。",
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.create" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceAlias", "agentId"],
          "properties": {
            "workspaceAlias": { "type": "string", "minLength": 1, "maxLength": 128, "description": "本机已登记 workspace 的别名；规范化路径不得出现在 wire 上。" },
            "agentId": { "type": "string", "minLength": 1, "maxLength": 128, "description": "本机已配置的 Agent profile 标识。" }
          }
        }
      }
    },
    "sessionReadBefore": {
      "description": "session.read 的分页游标：由消息创建时间与消息标识复合构成（design D2）。两个键都必需——只给其中一项是单字段游标，按 protocol.schema_invalid 拒绝，服务端 MUST NOT 猜测或补全缺失的排序分量。排序 MUST NOT 依赖 messageId 的数值或字典序（docs/SYNC_PROTOCOL.md §3.3、§11.5）：服务端按 createdAt 升序返回一页，并在同一 createdAt 内以稳定可重复的次序排列 messageId 作为 tie-breaker，使相邻两页不重不漏。",
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "messageId"],
      "properties": {
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "sessionReadLimit": {
      "description": "客户端请求的单页上限，是结构性计数（integer，与 chunkCount 同类，§3.3）。省略时服务端按配置默认页返回；超过服务端为该会话配置的明细条数上限时服务端收敛到自己的上限并照常返回，MUST NOT 因此让请求失败，因此本字段没有 maximum。",
      "type": "integer",
      "minimum": 1
    },
    "sessionRead": {
      "description": "Sync 面的 session.read：before 与 limit 只在本传输面生效（design D3）。Node Link 面的同名命令载荷不含这两个键，其行为与本变更前一致（docs/NODE_LINK_PROTOCOL.md §12.7）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.read" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["messages", "turns", "pending_interactions", "config_options", "capabilities"] }
            },
            "before": { "$ref": "#/$defs/sessionReadBefore" },
            "limit": { "$ref": "#/$defs/sessionReadLimit" }
          }
        }
      }
    },
    "sessionPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.prompt" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "common.schema.json#/$defs/promptContentBlock" }
            }
          }
        }
      }
    },
    "sessionCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.cancel" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turnId"],
          "properties": { "turnId": { "$ref": "common.schema.json#/$defs/uuid" } }
        }
      }
    },
    "configList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.config.list" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": { "type": "object", "additionalProperties": false }
      }
    },
    "configSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "expectedVersion", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.config.set" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "expectedVersion": { "$ref": "common.schema.json#/$defs/decimalString" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configId", "value"],
          "properties": {
            "configId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "value": { "type": ["string", "boolean"] }
          }
        }
      }
    },
    "modeList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.mode.list" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": { "type": "object", "additionalProperties": false }
      }
    },
    "modeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "expectedVersion", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "session.mode.set" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "expectedVersion": { "$ref": "common.schema.json#/$defs/decimalString" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modeId"],
          "properties": { "modeId": { "type": "string", "minLength": 1, "maxLength": 256 } }
        }
      }
    },
    "permissionResolve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "permission.resolve" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interactionId", "optionId"],
          "properties": {
            "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
            "optionId": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    },
    "elicitationRespond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "sessionId", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "elicitation.respond" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["interactionId", "action", "values"],
              "properties": {
                "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "action": { "const": "submit" },
                "values": { "type": ["object", "null"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["interactionId", "action", "values"],
              "properties": {
                "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "action": { "const": "decline" },
                "values": { "type": "null" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["interactionId", "action", "values"],
              "properties": {
                "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "action": { "const": "cancel" },
                "values": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "commandStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "command", "payload"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "command.status" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetRequestId"],
          "properties": { "targetRequestId": { "$ref": "#/$defs/requestId" } }
        }
      }
    },
    "sessionListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/sessionSummary" }
        }
      }
    },
    "sessionReadResult": {
      "description": "session.read 的完成结果。resources 的每个键都可缺席；hasEarlier 是必填布尔值，指示本次返回的这一页之前是否仍有更早内容，客户端据此决定是否继续用最早一条的 (createdAt, messageId) 构造 before 翻页。",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "resources", "hasEarlier"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "messages": {
              "type": "array",
              "items": { "$ref": "sync.schema.json#/$defs/snapshotItem.messages" }
            },
            "turns": {
              "type": "array",
              "items": { "$ref": "sync.schema.json#/$defs/snapshotItem.turns" }
            },
            "pending_interactions": {
              "type": "array",
              "items": { "$ref": "sync.schema.json#/$defs/snapshotItem.pending_interactions" }
            },
            "config_options": {
              "type": "array",
              "items": { "$ref": "sync.schema.json#/$defs/snapshotItem.config_options" }
            },
            "capabilities": {
              "type": "array",
              "items": { "$ref": "sync.schema.json#/$defs/snapshotItem.capabilities" }
            }
          }
        },
        "hasEarlier": { "type": "boolean" }
      }
    },
    "configListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configOptions", "version"],
      "properties": {
        "configOptions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/configOptionView" }
        },
        "version": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "modeListResult": { "$ref": "common.schema.json#/$defs/modeState" },
    "sessionCreateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "session"],
      "description": "session.create 的 completed 结果：新会话标识 + 其 SessionSummary。",
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "session": { "$ref": "common.schema.json#/$defs/sessionSummary" }
      }
    },
    "commandStatusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRequestId", "state", "acceptedAt", "terminalAt", "terminalEventId", "result", "error"],
      "properties": {
        "targetRequestId": { "$ref": "#/$defs/requestId" },
        "state": { "enum": ["accepted", "completed", "failed", "uncertain", "rejected"] },
        "acceptedAt": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        },
        "terminalAt": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        },
        "terminalEventId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "result": { "type": ["object", "null"] },
        "error": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/publicError" }, { "type": "null" }]
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "connectionId", "connectionSequence", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "command.result" },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionSequence": { "$ref": "common.schema.json#/$defs/decimalString" },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "command", "status", "acceptedAt", "terminalEventId", "result", "error"],
          "properties": {
            "requestId": { "$ref": "#/$defs/requestId" },
            "command": { "$ref": "#/$defs/commandName" },
            "status": { "enum": ["accepted", "completed", "failed", "rejected", "uncertain"] },
            "acceptedAt": {
              "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
            },
            "terminalEventId": {
              "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
            },
            "result": { "type": ["object", "null"] },
            "error": {
              "oneOf": [{ "$ref": "common.schema.json#/$defs/publicError" }, { "type": "null" }]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "command": { "const": "session.list" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/sessionListResult" } } }
            },
            {
              "if": {
                "properties": { "command": { "const": "session.create" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/sessionCreateResult" } } }
            },
            {
              "if": {
                "properties": { "command": { "const": "session.read" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/sessionReadResult" } } }
            },
            {
              "if": {
                "properties": { "command": { "const": "session.config.list" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/configListResult" } } }
            },
            {
              "if": {
                "properties": { "command": { "const": "session.mode.list" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/modeListResult" } } }
            },
            {
              "if": {
                "properties": { "command": { "const": "command.status" }, "status": { "const": "completed" } },
                "required": ["command", "status"]
              },
              "then": { "properties": { "result": { "$ref": "#/$defs/commandStatusRecord" } } }
            },
            {
              "if": {
                "properties": {
                  "command": { "enum": ["session.list", "session.read", "command.status", "session.mode.list", "session.config.list"] },
                  "status": { "const": "completed" }
                },
                "required": ["command", "status"]
              },
              "then": { "properties": { "terminalEventId": { "type": "null" } } }
            },
            {
              "if": {
                "properties": {
                  "command": { "enum": ["session.prompt", "session.cancel", "elicitation.respond", "session.mode.set", "session.config.set", "permission.resolve", "session.create"] },
                  "status": { "const": "completed" }
                },
                "required": ["command", "status"]
              },
              "then": { "properties": { "terminalEventId": { "$ref": "common.schema.json#/$defs/uuid" } } }
            },
            {
              "if": {
                "properties": { "status": { "const": "accepted" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "acceptedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                  "terminalEventId": { "type": "null" },
                  "error": { "type": "null" }
                }
              }
            },
            {
              "if": {
                "properties": { "status": { "enum": ["failed", "uncertain"] } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "acceptedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                  "terminalEventId": { "$ref": "common.schema.json#/$defs/uuid" }
                }
              }
            },
            {
              "if": {
                "properties": { "status": { "const": "rejected" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "acceptedAt": { "type": "null" },
                  "terminalEventId": { "type": "null" },
                  "result": { "type": "null" },
                  "error": { "$ref": "common.schema.json#/$defs/publicError" }
                }
              }
            }
          ]
        }
      }
    }
  }
}
