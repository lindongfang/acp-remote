      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "command": {
          "const": "workspace.mkdir"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parentPath",
            "name"
          ],
          "properties": {
            "parentPath": {
