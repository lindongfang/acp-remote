{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/sync.schema.json",
  "title": "ACP Remote Sync v1 Synchronization Messages",
  "oneOf": [
    { "$ref": "#/$defs/subscribe" },
    { "$ref": "#/$defs/caughtUp" },
    { "$ref": "#/$defs/resetRequired" },
    { "$ref": "#/$defs/snapshotRequest" },
    { "$ref": "#/$defs/snapshotBegin" },
    { "$ref": "#/$defs/snapshotChunk" },
    { "$ref": "#/$defs/snapshotEnd" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/remoteSubscribe" },
    { "$ref": "#/$defs/remoteEvent" },
    { "$ref": "#/$defs/remoteCaughtUp" },
    { "$ref": "#/$defs/remoteAck" },
    { "$ref": "#/$defs/remoteResetRequired" },
    { "$ref": "#/$defs/remoteUnsubscribe" },
    { "$ref": "#/$defs/remoteUnavailable" },
    { "$ref": "#/$defs/remoteCatalogChanged" },
    { "$ref": "#/$defs/remoteSourceState" }
  ],
  "$defs": {
    "postAuthBase": {
      "type": "object",
      "required": ["protocolVersion", "type", "messageId", "connectionId", "connectionSequence", "body"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "connectionSequence": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "subscribe": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.subscribe" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cursor", "scope"],
              "properties": {
                "cursor": { "oneOf": [{ "$ref": "common.schema.json#/$defs/cursor" }, { "type": "null" }] },
                "scope": { "const": "machine" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "caughtUp": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.caught_up" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cursor"],
              "properties": { "cursor": { "$ref": "common.schema.json#/$defs/cursor" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "resetRequired": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.reset_required" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "snapshotAvailable"],
              "properties": {
                "reason": { "enum": ["initial_sync", "epoch_mismatch", "cursor_expired", "cache_incompatible"] },
                "snapshotAvailable": { "type": "boolean" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshotRequest": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.snapshot_request" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": {
                "reason": { "enum": ["initial_sync", "epoch_mismatch", "cursor_expired", "cache_incompatible"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshotBegin": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.snapshot_begin" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId", "cursor", "schemaVersion", "chunkCount"],
              "properties": {
                "snapshotId": { "$ref": "common.schema.json#/$defs/uuid" },
                "cursor": { "$ref": "common.schema.json#/$defs/cursor" },
                "schemaVersion": { "const": 1 },
                "chunkCount": { "$ref": "#/$defs/snapshotChunkCount" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshotChunkCount": {
      "description": "本次快照实际下发的 chunk 数，begin 与 end 必须一致。上界等于可下发资源的种类数（$defs/snapshotResource），因此快照至多承载清单类资源；未协商 core.local-catalog.v1 时只下发 sessions，取 1。",
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "snapshotChunk": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.snapshot_chunk" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId", "chunkIndex", "resource", "items"],
              "properties": {
                "snapshotId": { "$ref": "common.schema.json#/$defs/uuid" },
                "chunkIndex": { "$ref": "common.schema.json#/$defs/decimalString" },
                "resource": { "$ref": "#/$defs/snapshotResource" },
                "items": { "type": "array", "maxItems": 10000 }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "resource": { "const": "sessions" } },
                    "required": ["resource"]
                  },
                  "then": {
                    "properties": {
                      "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/snapshotItem.sessions" } }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "resource": { "const": "workspaces" } },
                    "required": ["resource"]
                  },
                  "then": {
                    "properties": {
                      "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/snapshotItem.workspaces" } }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "resource": { "const": "agents" } },
                    "required": ["resource"]
                  },
                  "then": {
                    "properties": {
                      "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/snapshotItem.agents" } }
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshotEnd": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.snapshot_end" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshotId", "cursor", "chunkCount", "snapshotDigest"],
              "properties": {
                "snapshotId": { "$ref": "common.schema.json#/$defs/uuid" },
                "cursor": { "$ref": "common.schema.json#/$defs/cursor" },
                "chunkCount": { "$ref": "#/$defs/snapshotChunkCount" },
                "snapshotDigest": { "$ref": "common.schema.json#/$defs/base64url32" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ack": {
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.ack" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cursor"],
              "properties": { "cursor": { "$ref": "common.schema.json#/$defs/cursor" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteSubscribe": {
      "description": "`sync.remote_subscribe`（docs/SYNC_PROTOCOL.md §9.7，design D3）：按 `(ownerNodeId, sessionId)` 订阅单个来源会话。`cursor` 为 `null` 时先取得 Owner 当前元数据屏障 B 并回 `remote_reset_required`；非空时从该 Owner origin cursor 增量重放。只在 `resource.stateless-origin.v1` 协商后合法。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_subscribe" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "sessionRef", "cursor"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "sessionRef": { "$ref": "common.schema.json#/$defs/sessionRef" },
                "cursor": {
                  "oneOf": [
                    { "$ref": "common.schema.json#/$defs/originCursor" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteEvent": {
      "description": "`sync.remote_event`（§9.7，design D3）：Owner 来源事件逐字转发。事件保留 `resource.event` 的 origin 三元组与 `payloadDigest`，**不带** Access 的 `globalSequence`/`sessionSequence`；`payload.acp` 的原始 ACP 文本逐字保留，不按通用数字 DTO 重编码。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_event" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "event"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "event": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "originEventId",
                    "originEpoch",
                    "originSequence",
                    "sessionRef",
                    "eventType",
                    "payloadDigest",
                    "createdAt",
                    "payload"
                  ],
                  "properties": {
                    "originEventId": { "$ref": "common.schema.json#/$defs/uuid" },
                    "originEpoch": { "$ref": "common.schema.json#/$defs/uuid" },
                    "originSequence": { "$ref": "common.schema.json#/$defs/decimalString" },
                    "sessionRef": { "$ref": "common.schema.json#/$defs/sessionRef" },
                    "eventType": {
                      "type": "string",
                      "pattern": "^[a-z0-9_.-]{1,128}$"
                    },
                    "payloadDigest": { "$ref": "common.schema.json#/$defs/base64url32" },
                    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "anyOf": [{ "required": ["view"] }, { "required": ["acp"] }],
                      "description": "与 Node Link `resource.event.payload` 同义：事件类型有登记 view 时必须携带 view；无法形成 view 时必须保留 acp 原文档。二者至少要有一个。",
                      "properties": {
                        "view": {
                          "type": "object",
                          "additionalProperties": true,
                          "description": "开放视图：扩展字段原样保留，按 `SYNC_PROTOCOL.md` §10.3 解释登记字段。"
                        },
                        "acp": { "$ref": "common.schema.json#/$defs/rawAcp" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteCaughtUp": {
      "description": "`sync.remote_caught_up`（§9.7，design D4）：Owner 已完成来源重放屏障。此帧之后才发送实时事件；客户端 MUST NOT 用定时器推测追平。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_caught_up" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "cursor"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "cursor": { "$ref": "common.schema.json#/$defs/originCursor" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteAck": {
      "description": "`sync.remote_ack`（§9.7，design D5）：仅本次连接该订阅的连续处理进度；不落盘、不表示可恢复索引，也不作为任何客户端已阅读或持久恢复承诺。Access 不保存该值。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_ack" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "cursor"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "cursor": { "$ref": "common.schema.json#/$defs/originCursor" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteResetRequired": {
      "description": "`sync.remote_reset_required`（§9.7，design D4）：客户端必须回源 `session.read` 重建。`reason` 复用既有 reset 词表（不含 `initial_sync`）；`cursor` 只在 Owner 已给出有效 head 时出现，否则为 `null`。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_reset_required" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "reason", "cursor"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "reason": {
                  "enum": ["epoch_mismatch", "cursor_expired", "cache_incompatible"]
                },
                "cursor": {
                  "oneOf": [
                    { "$ref": "common.schema.json#/$defs/originCursor" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteUnsubscribe": {
      "description": "`sync.remote_unsubscribe`（§9.7）：取消本连接上的订阅及其所属观察者；不改变 Owner 侧任何持久状态。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_unsubscribe" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteUnavailable": {
      "description": "`sync.remote_unavailable`（§9.7，design D4/D6）：断线、撤销与不支持分别使用既有错误码（`resource.remote_unavailable`、`auth.device_revoked`、`capability.unsupported_by_broker` 等），本消息不新造错误码。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_unavailable" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subscriptionId", "error"],
              "properties": {
                "subscriptionId": { "$ref": "common.schema.json#/$defs/uuid" },
                "error": { "$ref": "common.schema.json#/$defs/publicError" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteCatalogChanged": {
      "description": "`sync.remote_catalog_changed`（§9.7，design D6）：该来源清单失效，客户端重新查询；不携带任何旧资源副本。`revision` 是十进制字符串。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_catalog_changed" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownerNodeId", "revision"],
              "properties": {
                "ownerNodeId": { "$ref": "common.schema.json#/$defs/uuid" },
                "revision": { "$ref": "common.schema.json#/$defs/decimalString" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteSourceState": {
      "description": "`sync.remote_source_state`（§9.7，design D6）：来源连接事实。它不是 owned 业务事件，不写入本地 owned 事件流，只在连接期发送。",
      "allOf": [
        { "$ref": "#/$defs/postAuthBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "sync.remote_source_state" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownerNodeId", "state"],
              "properties": {
                "ownerNodeId": { "$ref": "common.schema.json#/$defs/uuid" },
                "state": { "enum": ["online", "offline", "revoked"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "snapshotResource": {
      "description": "sync.snapshot_chunk.resource 的封闭词表：快照只承载 sessions/workspaces/agents 三类清单资源。六类 session-scoped 明细资源 messages/turns/pending_interactions/config_options/capabilities/history 一律不进快照，无论会话的 origin.kind 是 local 还是 remote（docs/SYNC_PROTOCOL.md §9.4，design D1）；除 `pending_interactions` 改用 `media.schema.json#/$defs/effectiveInteraction` 外，它们的元素形状仍由下面的 snapshotItem.* 定义，供 session.read 的结果复用（command.schema.json#/$defs/sessionReadResult.resources）。本枚举的取值与 crates/sync-protocol 的 sync::SnapshotResource::ALL 逐条同序，由 tests/schema_drift.rs::snapshot_resources_match_schema_enum 双向门禁。",
      "enum": ["sessions", "workspaces", "agents"]
    },
    "snapshotItem.sessions": { "$ref": "common.schema.json#/$defs/sessionSummary" },
    "snapshotItem.messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "sessionId", "role", "content", "status", "createdAt", "turnId"],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "role": { "enum": ["user", "agent"] },
        "content": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/agentContentBlock" }
        },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "turnId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "channel": {
          "description": "消息通道（`core.typed-media.v1`）：`reply` 与 `thought` 分别持久化。未协商该 feature 的连接不下发该键，旧 peer 的 shape 逐字不变（docs/SYNC_PROTOCOL.md §10.4/§11.5）。",
          "$ref": "media.schema.json#/$defs/messageChannel"
        },
        "partial": {
          "description": "正文完整性（`core.typed-media.v1`）：`partial` 表示已收到内容被保留但上游未完成，MUST NOT 被当作完整成功回复（docs/SYNC_PROTOCOL.md §10.4）。",
          "$ref": "media.schema.json#/$defs/partialResult"
        }
      }
    },
    "snapshotItem.turns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "sessionId", "state", "createdAt", "startedAt", "completedAt", "terminalError"],
      "properties": {
        "turnId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "startedAt": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        },
        "completedAt": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        },
        "terminalError": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/publicError" }, { "type": "null" }]
        }
      }
    },
    "snapshotItem.pending_interactions": {
      "description": "会话范围待处理交互的基础定位形状（interactionId/sessionId/kind/state/schema/createdAt）。`session.read` 的 `resources.pending_interactions` 自 `conversation-area-complete` 起返回服务端确认过的 `effectiveInteraction`（`media.schema.json#/$defs/effectiveInteraction`，含 `requestVersion`/`options`/`expiresAt`）；本定义只保留历史卡片与内部条目所需的定位信息，历史条目不能直接应答（docs/SYNC_PROTOCOL.md §11.7）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["interactionId", "sessionId", "kind", "state", "schema", "createdAt"],
      "properties": {
        "interactionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "kind": { "enum": ["permission", "elicitation"] },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "schema": { "type": "object" },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "snapshotItem.config_options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "configOptions", "version"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "configOptions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/configOptionView" }
        },
        "version": { "$ref": "common.schema.json#/$defs/decimalString" }
      }
    },
    "snapshotItem.capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "agentCapabilities", "brokerAdditions"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "agentCapabilities": { "type": "object" },
        "brokerAdditions": { "type": "object" }
      }
    },
    "snapshotItem.history": {
      "description": "会话的结构化历史条目的单个元素（session.read 的 resources.history），与 event.schema.json 的 body.payload 同形：eventId/eventType/sessionSequence/createdAt 定位事件，view 是与实时事件同一套解析入口的结构化视图，acp 按 acp.raw-payload.v1 的协商结果出现。view 是开放对象——每个事件类型的最低字段见 event-views.schema.json，这里不展开；acp 缺席或 rawUnavailable 都表示原文不可用，服务端 MUST NOT 用占位内容冒充原文。本元素与其余 snapshotItem.* 一样只经 session.read 返回，MUST NOT 进入快照（docs/SYNC_PROTOCOL.md §9.4、§10.2、§11.5）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "sessionSequence", "createdAt", "view"],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/uuid" },
        "eventType": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,128}$"
        },
        "sessionSequence": { "$ref": "common.schema.json#/$defs/decimalString" },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "view": { "type": "object" },
        "acp": { "$ref": "common.schema.json#/$defs/rawAcp" }
      }
    },
    "snapshotItem.workspaces": { "$ref": "common.schema.json#/$defs/workspaceCatalogEntry" },
    "snapshotItem.agents": { "$ref": "common.schema.json#/$defs/agentCatalogEntry" }
  }
}
