{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp-remote.dev/schemas/sync/v1/pairing.schema.json",
  "title": "ACP Remote Pairing v1 HTTP Payloads",
  "oneOf": [
    { "$ref": "#/$defs/claimRequest" },
    { "$ref": "#/$defs/claimResponse" },
    { "$ref": "#/$defs/statusRequest" },
    { "$ref": "#/$defs/statusResponse" },
    { "$ref": "#/$defs/lookupRequest" },
    { "$ref": "#/$defs/lookupResponse" },
    { "$ref": "#/$defs/qrLookupRequest" },
    { "$ref": "#/$defs/httpError" }
  ],
  "$defs": {
    "canonicalOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+$",
      "maxLength": 2048
    },
    "claimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "pairingId", "hostId", "deviceId", "deviceName", "clientKind", "canonicalOrigin", "devicePublicKey", "clientNonce", "proof"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "pairingId": { "$ref": "common.schema.json#/$defs/uuid" },
        "hostId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deviceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientKind": { "enum": ["pwa", "android", "ios", "desktop"] },
        "canonicalOrigin": { "$ref": "#/$defs/canonicalOrigin" },
        "devicePublicKey": { "$ref": "common.schema.json#/$defs/base64url65" },
        "clientNonce": { "$ref": "common.schema.json#/$defs/base64url32" },
        "proof": { "$ref": "common.schema.json#/$defs/base64url32" }
      }
    },
    "claimResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "pairingRequestId", "serverNonce", "hostProof", "status", "expiresAt"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "pairingRequestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "serverNonce": { "$ref": "common.schema.json#/$defs/base64url32" },
        "hostProof": { "$ref": "common.schema.json#/$defs/base64url64" },
        "status": { "const": "pending_confirmation" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "hostId", "deviceId", "pairingId", "pairingRequestId", "requestNonce", "proof"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "hostId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deviceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "pairingId": { "$ref": "common.schema.json#/$defs/uuid" },
        "pairingRequestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "requestNonce": { "$ref": "common.schema.json#/$defs/base64url32" },
        "proof": { "$ref": "common.schema.json#/$defs/base64url32" }
      }
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "pairingRequestId", "status", "expiresAt"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "pairingRequestId": { "$ref": "common.schema.json#/$defs/uuid" },
        "status": { "enum": ["pending_confirmation", "approved", "rejected", "expired", "consumed"] },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deviceId", "name"],
          "description": "已批准分支的设备非秘密元数据。设备方向没有授权维度（`pairing-model` 删除设备权限层），因此这里不再有授权集合字段。",
          "properties": {
            "deviceId": { "$ref": "common.schema.json#/$defs/uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostId", "hostPublicKey"],
          "properties": {
            "hostId": { "$ref": "common.schema.json#/$defs/uuid" },
            "hostPublicKey": { "$ref": "common.schema.json#/$defs/base64url65" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          "then": { "required": ["device", "host"] },
          "else": {
            "not": { "anyOf": [{ "required": ["device"] }, { "required": ["host"] }] }
          }
        }
      ]
    },
    "lookupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "pairingCode"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "pairingCode": {
          "type": "string",
          "description": "8 位 Crockford base32（40 bit），大小写不敏感；允许在 4+4 之间带一个 `-`。服务端先把 `I`/`L` 归一化为 `1`、`O` 归一化为 `0` 再比较；`U` 不在 Crockford 字母表内。",
          "pattern": "^[0-9A-HIJ-KLM-NOP-TV-Za-hij-klm-nop-tv-z]{4}-?[0-9A-HIJ-KLM-NOP-TV-Za-hij-klm-nop-tv-z]{4}$"
        }
      }
    },
    "lookupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "pairingId", "hostId", "hostPublicKey", "canonicalOrigin", "pairingSecret", "expiresAt"],
      "description": "lookup 成功只返回取回绑定所需的材料；不推进配对状态，成功即消耗配对码。",
      "properties": {
        "protocolVersion": { "const": 1 },
        "pairingId": { "$ref": "common.schema.json#/$defs/uuid" },
        "hostId": { "$ref": "common.schema.json#/$defs/uuid" },
        "hostPublicKey": { "$ref": "common.schema.json#/$defs/base64url65" },
        "canonicalOrigin": { "$ref": "#/$defs/canonicalOrigin" },
        "pairingSecret": { "$ref": "common.schema.json#/$defs/base64url32" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "qrLookupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "qrToken"],
      "description": "扫码取回凭据换回配对绑定。qrToken 是设备创建时独立生成的 32 字节凭据，与配对码、配对秘密互不相同；请求不携带 canonical origin 字段，来源由 HTTP Origin 头与配对登记绑定比较。",
      "properties": {
        "protocolVersion": { "const": 1 },
        "qrToken": { "$ref": "common.schema.json#/$defs/base64url32" }
      }
    },
    "qrLookupResponse": {
      "description": "扫码取回成功返回与配对码 lookup 同形的七个字段；不推进配对状态、不消耗配对码、不创建信任。因为形状与 lookupResponse 逐字节相同，它只在 $defs 里保留命名，不重复进入顶层 oneOf（否则同一响应会同时匹配两个分支）。",
      "$ref": "#/$defs/lookupResponse"
    },
    "httpError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "correlationId", "details"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/errorCode" },
        "message": { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" },
        "correlationId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
        },
        "details": { "type": "object" }
      }
    }
  }
}
