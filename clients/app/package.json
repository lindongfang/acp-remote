{
  "name": "acp-remote-app",
  "version": "0.0.0",
  "private": true,
  "description": "ACP Remote Web/PWA 客户端（`docs/FRONTEND_DESIGN.md` §3 的七层工程）。v1 只交付 Web/PWA，不产出 Android/iOS 原生包；本包自身的类型检查与测试脚本独立于仓库根 `npm run check`。",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "export:web": "expo export --platform web && node scripts/adapt-entry-document.mjs && node scripts/write-build-version.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:e2e": "tsc --project e2e/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "service": "vite preview",
    "check": "npm run typecheck && npm run typecheck:e2e && npm run test && npm run export:web"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-constants": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "esbuild": "^0.28.2",
    "react-test-renderer": "19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
}
