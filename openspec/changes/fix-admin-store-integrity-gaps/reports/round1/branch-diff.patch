+/// SHA-256），而 `owned_peer_key`/`owned_pairing_peer`/`owned_device` 三张表都各自只有列级 CHECK。
+fn verify_identity_material(
+    public_key: PeerPublicKey,
+    stored: &Fingerprint,
+    mismatch: &'static str,
