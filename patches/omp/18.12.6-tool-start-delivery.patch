diff --git a/packages/agent/test/tool-start-delivery.test.ts b/packages/agent/test/tool-start-delivery.test.ts
new file mode 100644
index 0000000..84363e9
--- /dev/null
+++ b/packages/agent/test/tool-start-delivery.test.ts
@@ -0,0 +1,71 @@
+import { expect, it } from "bun:test";
+import { type } from "@oh-my-pi/omptype";
+import { Agent, type AgentTool } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+
+it("publishes tool starts before an execute wrapper can request client permission", async () => {
+	const wire: string[] = [];
+	const parameters = type({});
+	const tools: AgentTool<typeof parameters, {}>[] = ["search", "bash"].map((name): AgentTool<typeof parameters, {}> => ({
+		name,
+		label: name,
+		description: name,
+		parameters,
+		concurrency: "shared",
+		async execute() {
+			// ACP's permission gate runs inside the tool's execute wrapper.
+			// Model that immediate wire side effect without opening a dialog.
+			if (name === "bash") wire.push("permission");
+			return { content: [{ type: "text", text: "ok" }], details: {} };
+		},
+	}));
+	const mock = createMockModel({ responses: [
+		{ content: [
+			{ type: "toolCall", id: "search", name: "search", arguments: {} },
+			{ type: "toolCall", id: "bash", name: "bash", arguments: {} },
+		] },
+		{ content: ["done"] },
+	] });
+	const agent = new Agent({
+		initialState: { model: mock.model, systemPrompt: ["Test"], tools, messages: [] },
+		streamFn: mock.stream,
+	});
+	const unsubscribe = agent.subscribe(event => {
+		if (event.type === "tool_execution_start") wire.push(event.toolCallId);
+	});
+	try {
+		await agent.prompt("start");
+		expect(wire).toEqual(["search", "bash", "permission"]);
+	} finally {
+		unsubscribe();
+	}
+});
+
+it("does not execute the tool when a start observer cancels the run", async () => {
+	let executed = false;
+	const parameters = type({});
+	const tool: AgentTool<typeof parameters, {}> = {
+		name: "bash", label: "bash", description: "test", parameters,
+		async execute() {
+			executed = true;
+			return { content: [{ type: "text", text: "unexpected" }], details: {} };
+		},
+	};
+	const mock = createMockModel({ responses: [{ content: [
+		{ type: "toolCall", id: "cancelled", name: "bash", arguments: {} },
+	] }] });
+	const agent = new Agent({
+		initialState: { model: mock.model, systemPrompt: ["Test"], tools: [tool], messages: [] },
+		streamFn: mock.stream,
+	});
+	const unsubscribe = agent.subscribe(event => {
+		if (event.type === "tool_execution_start") agent.abort();
+	});
+	try {
+		await agent.prompt("start");
+		expect(executed).toBe(false);
+		expect(agent.state.isStreaming).toBe(false);
+	} finally {
+		unsubscribe();
+	}
+});
diff --git a/packages/coding-agent/test/acp-tool-order-wire.test.ts b/packages/coding-agent/test/acp-tool-order-wire.test.ts
new file mode 100644
index 0000000..61c5c2b
--- /dev/null
+++ b/packages/coding-agent/test/acp-tool-order-wire.test.ts
@@ -0,0 +1,61 @@
+import { expect, it } from "bun:test";
+import { type } from "@oh-my-pi/omptype";
+import { Agent, type AgentTool } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { AgentSideConnection, ClientSideConnection, ndJsonStream } from "@oh-my-pi/pi-utils/acp";
+import { createAcpClientBridge } from "@oh-my-pi/pi-coding-agent/modes/acp/acp-client-bridge";
+import { mapAgentSessionEventToAcpSessionUpdates } from "@oh-my-pi/pi-coding-agent/modes/acp/acp-event-mapper";
+
+it("delivers both tool starts to the ACP peer before its permission dialog", async () => {
+	const agentToClient = new TransformStream<Uint8Array, Uint8Array>();
+	const clientToAgent = new TransformStream<Uint8Array, Uint8Array>();
+	const wire: string[] = [];
+	const server = new AgentSideConnection(() => ({
+		initialize: () => ({ protocolVersion: 1 }),
+		newSession: () => ({ sessionId: "test" }),
+		prompt: () => ({ stopReason: "end_turn" }),
+		cancel: () => {},
+	}), ndJsonStream(agentToClient.writable, clientToAgent.readable));
+	const client = new ClientSideConnection(() => ({
+		sessionUpdate(params) {
+			if (params.update.sessionUpdate === "tool_call") wire.push(params.update.toolCallId);
+		},
+		requestPermission() {
+			wire.push("permission");
+			return { outcome: { outcome: "selected", optionId: "reject_once" } };
+		},
+	}), ndJsonStream(clientToAgent.writable, agentToClient.readable));
+	const bridge = createAcpClientBridge(server, "test", {});
+	const parameters = type({});
+	const tools: AgentTool<typeof parameters, {}>[] = ["search", "bash"].map((name): AgentTool<typeof parameters, {}> => ({
+		name, label: name, description: name, parameters, concurrency: "shared",
+		async execute(toolCallId, _args, signal) {
+			if (name === "bash") await bridge.requestPermission!({ toolCallId, toolName: name, title: name }, [
+				{ optionId: "reject_once", name: "Reject", kind: "reject_once" },
+			], signal);
+			return { content: [{ type: "text", text: "ok" }], details: {} };
+		},
+	}));
+	const mock = createMockModel({ responses: [
+		{ content: [
+			{ type: "toolCall", id: "search", name: "search", arguments: {} },
+			{ type: "toolCall", id: "bash", name: "bash", arguments: {} },
+		] }, { content: ["done"] },
+	] });
+	const agent = new Agent({ initialState: { model: mock.model, systemPrompt: ["Test"], tools, messages: [] }, streamFn: mock.stream });
+	const deliveries: Promise<void>[] = [];
+	const unsubscribe = agent.subscribe(event => {
+		for (const update of mapAgentSessionEventToAcpSessionUpdates(event, "test")) deliveries.push(server.sessionUpdate(update));
+	});
+	try {
+		await agent.prompt("start");
+		await Promise.all(deliveries);
+		expect(wire).toEqual(["search", "bash", "permission"]);
+	} finally {
+		unsubscribe();
+		await clientToAgent.writable.close();
+		await server.closed;
+		await agentToClient.writable.close();
+		await client.closed;
+	}
+});
