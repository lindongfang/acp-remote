+
+/// 同一测试里会登记多次配对，因此每次用不同的 pairingId（UUID 形状）。
+fn nth_pairing(n: u32) -> PairingId {
+    PairingId::new(&format!("5555555{n}-5555-4555-8555-555555555555")).expect("pairing id")
+}
+
+/// 日粒度时间戳下的完整设备配对流程（登记 → 认领 → 批准），供闲置清理用例使用。
+async fn approve_device_via(
+    store: &SqliteStore,
+    pairing: &PairingId,
+    id: &DeviceId,
+    created: Timestamp,
+    expires: Timestamp,
+    settle_at: Timestamp,
+) {
+    store
+        .create_pairing(PairingWrite {
+            record: PairingRecord::try_new(
+                pairing.clone(),
+                PairingTarget::Device,
+                PairingState::Created,
+                None,
+                ScopeSet::try_from_iter(["session.read"]).expect("scopes"),
+                GrantSet::empty(),
+                digest(PAIRING_SECRET),
+                HOST_BINDING,
+                created.clone(),
+                expires,
+                None,
+                None,
+                None,
+            )
+            .expect("pairing record"),
+            context: context_at(created.clone(), Vec::new()),
+        })
+        .await
+        .expect("create pairing");
+    let peer = PairingPeer::try_new(
+        PeerIdentity::Device(id.clone()),
+        "phone",
+        peer_public_key(),
+        HOST_BINDING,
+        nonce("day-nonce"),
+    )
+    .expect("peer");
+    let claim = acp_core::model::PairingClaim::try_new(
+        pairing.clone(),
+        peer,
+        ScopeSet::try_from_iter(["session.read"]).expect("scopes"),
+        GrantSet::empty(),
+    )
+    .expect("claim");
+    store
+        .claim_pairing(PairingClaimWrite {
+            claim,
+            context: context_at(created, Vec::new()),
+        })
+        .await
+        .expect("claim pairing");
+    store
+        .settle_pairing(PairingSettlementWrite {
+            pairing: pairing.clone(),
+            settlement: approved_settlement(),
+            context: context_at(settle_at, Vec::new()),
+        })
+        .await
+        .expect("settle pairing");
+}
+
+/// spec：闲置身份的保留与清理——窗口是固定 v1 常量 90 天（`IDLE_IDENTITY_RETENTION_DAYS`）：
+/// 已撤销的行从撤销时刻起算、未撤销的行从「最近一次成功认证/连接」起算，超过窗口即删除信任行、
+/// 身份材料与已过期的配对行，并写 `identity.pruned` 审计（审计历史不动）。
+#[tokio::test]
+async fn idle_identities_are_pruned_after_the_window() {
+    let dir = temp_dir("admin-idle-cleanup");
+    let store = open(&dir).await;
+    let peer = peer_node_id();
+    // ① 2026-01-01 配对、从未认证的设备（其配对行在 2026-02-01 过期）。
+    approve_device_via(
+        &store,
+        &nth_pairing(1),
+        &device_id(),
+        day(1, 1),
+        day(2, 1),
+        day(1, 1),
+    )
+    .await;
+    // ② 边界：恰好落在窗口边界（cutoff = 2026-01-31）上的设备。
+    let boundary = DeviceId::new("cccccccc-cccc-4ccc-8ccc-cccccccccccc").expect("device id");
+    approve_device_via(
+        &store,
+        &nth_pairing(2),
+        &boundary,
+        day(1, 31),
+        day(3, 1),
+        day(1, 31),
+    )
+    .await;
+    // ③ 未撤销但最近仍在使用的新设备：必须保留。
+    approve_device_via(
+        &store,
+        &nth_pairing(3),
+        &remote_device_id(),
+        day(4, 20),
+        day(6, 1),
+        day(4, 20),
+    )
+    .await;
+    // ④ 2026-01-01 写入、从未连接的节点。
+    let node_record = |created: Timestamp| {
+        NodeRecord::try_new(
+            peer.clone(),
+            "office access",
+            NodeKind::Access,
+            peer_public_key().fingerprint(),
+            GrantSet::try_from_iter(["grant.remote-work"]).expect("grants"),
+            NodeState::Paired,
+            None,
+            created,
+            None,
+            None,
+        )
+        .expect("node record")
+    };
+    store
+        .put_node(NodeWrite {
+            record: node_record(day(1, 1)),
+            public_key: peer_public_key(),
+            context: context_at(day(1, 1), Vec::new()),
+        })
+        .await
+        .expect("put node");
+
+    let report = store
+        .cleanup_idle_identities(IdleCleanupWrite {
+            idle_days: IDLE_IDENTITY_RETENTION_DAYS,
+            context: context_at(day(5, 1), Vec::new()),
+        })
+        .await
+        .expect("idle cleanup");
+    assert_eq!(
+        report.devices_pruned, 2,
+        "① 与边界② 都被清理（`<=` 是硬边界）"
+    );
+    assert_eq!(report.nodes_pruned, 1);
+    assert_eq!(
+        report.peer_keys_pruned, 3,
+        "设备 ×2 + 节点 ×1 的身份材料一并删除"
+    );
+    assert_eq!(
+        report.pairings_pruned, 2,
+        "已过期的配对行（① 与边界②）被清理，未过期的（③）保留"
+    );
+
+    assert!(store.device(&device_id()).await.expect("device").is_none());
+    assert!(store.device(&boundary).await.expect("device").is_none());
+    assert!(
+        store
+            .node(&peer, NodeKind::Access)
+            .await
+            .expect("node")
+            .is_none()
+    );
+    assert!(
+        store
+            .peer_key(&PeerIdentity::Device(device_id()))
+            .await
+            .expect("peer key")
+            .is_none()
+    );
+    assert!(
+        store
+            .peer_key(&PeerIdentity::Node(peer.clone()))
+            .await
+            .expect("peer key")
+            .is_none()
+    );
+    assert_eq!(
+        store
+            .device(&remote_device_id())
+            .await
+            .expect("device")
+            .expect("device row")
+            .state(),
+        DeviceState::Active,
+        "最近仍在使用的设备必须保留"
+    );
+
+    let path = dir.join(storage_sqlite::migrate::DATABASE_FILE);
+    store.close().await;
+    let pool = raw_pool(&path).await;
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_device").await,
+        1
+    );
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_node").await,
+        0
+    );
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_peer_key").await,
+        1
+    );
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_pairing").await,
+        1
+    );
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_pairing_peer").await,
+        1
+    );
+    assert_eq!(
+        audit_rows(&pool, AuditAction::IdentityPruned).await,
+        3,
+        "每条被清理的身份一条审计（设备 ×2 + 节点 ×1）"
+    );
+    pool.close().await;
+}
+
+/// 未撤销的身份按「最近一次成功认证」起算：`last_seen_at` 比 `created_at` 新就不算闲置。
+#[tokio::test]
+async fn a_recently_seen_identity_is_kept() {
+    let dir = temp_dir("admin-idle-seen");
+    let store = open(&dir).await;
+    approve_device_via(
+        &store,
+        &nth_pairing(4),
+        &device_id(),
+        day(1, 1),
+        day(2, 1),
+        day(1, 1),
+    )
+    .await;
+    // 2026-04-25 仍在使用（写入只能推进 `last_seen_at`）。
+    store
+        .put_device(DeviceWrite {
+            record: device_record_with_seen(peer_public_key().fingerprint(), Some(day(4, 25))),
+            context: context_at(day(4, 25), Vec::new()),
+        })
+        .await
+        .expect("record a successful authentication");
+
+    let report = store
+        .cleanup_idle_identities(IdleCleanupWrite {
+            idle_days: IDLE_IDENTITY_RETENTION_DAYS,
+            context: context_at(day(5, 1), Vec::new()),
+        })
+        .await
+        .expect("idle cleanup");
+    assert_eq!(report.devices_pruned, 0);
+    assert!(store.device(&device_id()).await.expect("device").is_some());
+    store.close().await;
+}
+
+/// 已撤销的身份从 `revoked_at` 起算：撤销后未满窗口不动，满窗口才清理；撤销审计保留。
+#[tokio::test]
+async fn revoked_identities_age_out_from_their_revocation() {
+    let dir = temp_dir("admin-idle-revoked");
+    let store = open(&dir).await;
+    approve_device_via(
+        &store,
+        &nth_pairing(5),
+        &device_id(),
+        day(1, 1),
+        day(3, 1),
+        day(1, 1),
+    )
+    .await;
+    store
+        .revoke_device(DeviceRevocation {
+            device: device_id(),
+            reason: RevokeReason::UserRequested,
+            context: context_at(
+                day(4, 25),
+                vec![audit(
+                    AuditAction::DeviceRevoked,
+                    EntityRef::Device(device_id()),
+                    AuditOutcome::Success,
+                )],
+            ),
+        })
+        .await
+        .expect("revoke device");
+
+    // 撤销后 6 天：保留（`created_at` 虽老，但时钟是 `revoked_at`）。
+    let early = store
+        .cleanup_idle_identities(IdleCleanupWrite {
+            idle_days: IDLE_IDENTITY_RETENTION_DAYS,
+            context: context_at(day(5, 1), Vec::new()),
+        })
+        .await
+        .expect("first cleanup");
+    assert_eq!(early.devices_pruned, 0);
+    // 撤销后 98 天：清理。
+    let late = store
+        .cleanup_idle_identities(IdleCleanupWrite {
+            idle_days: IDLE_IDENTITY_RETENTION_DAYS,
+            context: context_at(day(8, 1), Vec::new()),
+        })
+        .await
+        .expect("second cleanup");
+    assert_eq!(late.devices_pruned, 1);
+
+    let path = dir.join(storage_sqlite::migrate::DATABASE_FILE);
+    store.close().await;
+    let pool = raw_pool(&path).await;
+    assert_eq!(
+        scalar_i64(&pool, "SELECT COUNT(*) FROM owned_device").await,
+        0
+    );
+    assert_eq!(
+        audit_rows(&pool, AuditAction::DeviceRevoked).await,
+        1,
+        "撤销审计是历史记录，不随闲置清理消失"
+    );
+    assert_eq!(audit_rows(&pool, AuditAction::IdentityPruned).await, 1);
+    pool.close().await;
+}
+
+/// 清理后同一 id 可以重新配对：身份材料已删，§11.6 第 1 条的换绑限制只在该材料存在期间成立
+/// （因此后续重新配对可以带来新密钥、成为新身份，符合 §11.5 的「改身份」口径）。
+#[tokio::test]
+async fn a_pruned_identity_can_pair_again() {
+    let dir = temp_dir("admin-idle-repair");
+    let store = open(&dir).await;
+    approve_device_via(
+        &store,
+        &nth_pairing(6),
+        &device_id(),
+        day(1, 1),
+        day(2, 1),
+        day(1, 1),
+    )
+    .await;
+    store
+        .cleanup_idle_identities(IdleCleanupWrite {
+            idle_days: IDLE_IDENTITY_RETENTION_DAYS,
+            context: context_at(day(5, 1), Vec::new()),
+        })
+        .await
+        .expect("idle cleanup");
+    assert!(store.device(&device_id()).await.expect("device").is_none());
+
+    approve_device_via(
+        &store,
+        &nth_pairing(7),
+        &device_id(),
+        day(5, 2),
+        day(6, 2),
+        day(5, 2),
+    )
+    .await;
+    assert_eq!(
+        store
+            .device(&device_id())
+            .await
+            .expect("device")
+            .expect("device row")
+            .state(),
+        DeviceState::Active
+    );
+    let path = dir.join(storage_sqlite::migrate::DATABASE_FILE);
+    store.close().await;
+    let pool = raw_pool(&path).await;
+    assert_eq!(audit_rows(&pool, AuditAction::IdentityPruned).await, 1);
+    pool.close().await;
+}
+
