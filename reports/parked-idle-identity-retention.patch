+/// 为闲置身份清理补写 `identity.pruned`（§11.6）：每条被清理的身份一行，目标即该身份（设备或节点）。
+///
+/// 归因与 [`insert_expiry_audit`] 同口径：取写集审计的首条，调用方传空集合时退回 `LocalCli`——周期
+/// 清理是 daemon 自己的动作。
+pub(crate) async fn insert_prune_audit(
+    tx: &mut Transaction<'_, Sqlite>,
+    at: &Timestamp,
+    audit: &[PendingAudit],
+    target: &EntityRef,
+) -> Result<(), StorageError> {
+    let template = audit.first();
+    let actor = template.map_or(Actor::LocalCli, |row| row.actor.clone());
+    let (kind, id) = actor_key(&actor);
+    sqlx::query(INSERT_AUDIT)
+        .bind(at.as_str())
+        .bind(AuditAction::IdentityPruned.as_str())
+        .bind(kind.as_str())
+        .bind(&id)
+        .bind(
+            template
+                .and_then(|row| row.via_node.as_ref())
+                .map(NodeId::as_str),
+        )
+        .bind(template.and_then(|row| row.local_principal_ref.as_deref()))
+        .bind(target.kind())
+        .bind(target.target_id())
+        .bind(AuditOutcome::Success.as_str())
+        .bind(None::<&str>)
+        .execute(&mut **tx)
+        .await?;
+    Ok(())
+}
